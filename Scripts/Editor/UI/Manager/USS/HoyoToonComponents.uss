.ht-card {
    background-color: var(--bg-card);
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    overflow: hidden;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.ht-card-elevated,
.ht-panel,
.ht-section {
    background-color: var(--bg-elevated);
}

.ht-version-badge {
    background-color: rgba(10, 12, 18, 0.54);
    color: var(--text-primary);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    min-height: 24px;
    min-width: 0;
    overflow: hidden;
}

.ht-version-badge:hover {
    background-color: rgba(12, 14, 22, 0.74);
}

.ht-version-badge:disabled {
    opacity: 0.75;
}

.ht-user-profile-panel {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    min-height: 0;
    max-width: 100%;
    min-width: 0;
    background-color: transparent;
    color: var(--text-primary);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    overflow: visible;
}

.ht-user-profile-panel:hover {
    background-color: transparent;
    border-left-color: transparent;
    border-right-color: transparent;
    border-top-color: transparent;
    border-bottom-color: transparent;
}

.ht-user-profile-panel:disabled {
    opacity: 0.75;
}

.ht-user-avatar-frame {
    width: 88px;
    height: 88px;
    min-width: 88px;
    min-height: 88px;
    max-width: 88px;
    max-height: 88px;
    flex-shrink: 0;
    overflow: hidden;
    align-items: center;
    justify-content: center;
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgba(44, 12, 84, 0.96);
    border-right-color: rgba(44, 12, 84, 0.96);
    border-top-color: rgba(44, 12, 84, 0.96);
    border-bottom-color: rgba(44, 12, 84, 0.96);
    border-top-left-radius: 44px;
    border-top-right-radius: 44px;
    border-bottom-left-radius: 44px;
    border-bottom-right-radius: 44px;
    background-color: rgba(38, 10, 74, 0.84);
}

.ht-user-avatar-image {
    width: 82px;
    height: 82px;
}

.ht-user-avatar-initials {
    color: var(--text-primary);
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.ht-user-profile-text-stack {
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 0;
    margin-top: 1px;
    overflow: visible;
    align-items: center;
    width: 124px;
}

.ht-user-profile-name {
    color: var(--text-primary);
    font-size: 20px;
    -unity-font-style: bold;
    margin-left: 0;
    -unity-text-align: middle-center;
    width: 100%;
    min-height: 18px;
    height: 19px;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-outline-width: 0;
}

.ht-user-profile-uid {
    color: var(--text-secondary);
    font-size: 12px;
    margin-top: 2px;
    -unity-text-align: middle-center;
    width: 100%;
    min-height: 13px;
    height: 14px;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ht-user-profile-role {
    color: var(--accent-primary);
    font-size: 12px;
    -unity-font-style: bold;
    margin-top: 3px;
    padding-left: 7px;
    padding-right: 7px;
    padding-top: 1px;
    padding-bottom: 2px;
    -unity-text-align: middle-center;
    align-self: center;
    min-height: 18px;
    height: 19px;
    min-width: 0;
    max-width: 100%;
    background-color: rgba(18, 8, 34, 0.78);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(160, 105, 255, 0.40);
    border-right-color: rgba(160, 105, 255, 0.40);
    border-top-color: rgba(160, 105, 255, 0.40);
    border-bottom-color: rgba(160, 105, 255, 0.40);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    -unity-text-outline-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.ht-user-profile-tagline {
    color: rgba(230, 232, 238, 0.70);
    font-size: 11px;
    margin-top: 8px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: none;
}

.ht-width-standard .ht-user-profile-panel,
.ht-width-narrow .ht-user-profile-panel {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
}

.ht-width-standard .ht-user-avatar-frame,
.ht-width-narrow .ht-user-avatar-frame {
    width: 70px;
    height: 70px;
    min-width: 70px;
    min-height: 70px;
    max-width: 70px;
    max-height: 70px;
    border-top-left-radius: 35px;
    border-top-right-radius: 35px;
    border-bottom-left-radius: 35px;
    border-bottom-right-radius: 35px;
}

.ht-width-narrow .ht-user-avatar-frame {
    width: 56px;
    height: 56px;
    min-width: 56px;
    min-height: 56px;
    max-width: 56px;
    max-height: 56px;
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border-bottom-left-radius: 28px;
    border-bottom-right-radius: 28px;
}

.ht-width-standard .ht-user-avatar-image,
.ht-width-narrow .ht-user-avatar-image {
    width: 64px;
    height: 64px;
}

.ht-width-narrow .ht-user-avatar-image {
    width: 50px;
    height: 50px;
}

.ht-width-standard .ht-user-avatar-initials,
.ht-width-narrow .ht-user-avatar-initials {
    font-size: 19px;
}

.ht-width-standard .ht-user-profile-name,
.ht-width-narrow .ht-user-profile-name {
    font-size: 13px;
    min-height: 15px;
    height: 16px;
}

.ht-width-standard .ht-user-profile-uid {
    font-size: 11px;
    min-height: 13px;
    height: 14px;
    margin-top: 1px;
}

.ht-width-standard .ht-user-profile-role {
    font-size: 11px;
    min-height: 16px;
    height: 17px;
    margin-top: 1px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 1px;
}

.ht-width-standard .ht-user-profile-text-stack {
    width: 118px;
    margin-top: 0;
}

.ht-width-narrow .ht-user-profile-text-stack {
    width: 86px;
    margin-top: 0;
}

.ht-width-narrow .ht-user-profile-name,
.ht-width-narrow .ht-user-profile-uid {
    font-size: 10px;
}

.ht-width-narrow .ht-user-profile-uid {
    margin-top: 1px;
    min-height: 13px;
    height: 14px;
}

.ht-width-narrow .ht-user-profile-role {
    font-size: 11px;
    margin-top: 1px;
    min-height: 16px;
    height: 17px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 0;
    padding-bottom: 1px;
}

.ht-width-standard .ht-user-profile-tagline,
.ht-width-narrow .ht-user-profile-tagline {
    display: none;
}

.ht-version-badge--unknown {
    color: #7cd4ff;
    border-left-color: rgba(124, 212, 255, 0.45);
    border-right-color: rgba(124, 212, 255, 0.45);
    border-top-color: rgba(124, 212, 255, 0.45);
    border-bottom-color: rgba(124, 212, 255, 0.45);
}

.ht-version-badge--checking,
.ht-version-badge--applying {
    color: #7cd4ff;
    border-left-color: rgba(124, 212, 255, 0.45);
    border-right-color: rgba(124, 212, 255, 0.45);
    border-top-color: rgba(124, 212, 255, 0.45);
    border-bottom-color: rgba(124, 212, 255, 0.45);
}

.ht-version-badge--up-to-date {
    color: var(--success);
    border-left-color: rgba(76, 175, 109, 0.45);
    border-right-color: rgba(76, 175, 109, 0.45);
    border-top-color: rgba(76, 175, 109, 0.45);
    border-bottom-color: rgba(76, 175, 109, 0.45);
}

.ht-version-badge--update-available {
    color: var(--warning);
    border-left-color: rgba(255, 176, 32, 0.45);
    border-right-color: rgba(255, 176, 32, 0.45);
    border-top-color: rgba(255, 176, 32, 0.45);
    border-bottom-color: rgba(255, 176, 32, 0.45);
}

.ht-version-badge--local-ahead {
    color: var(--warning);
    border-left-color: rgba(255, 176, 32, 0.45);
    border-right-color: rgba(255, 176, 32, 0.45);
    border-top-color: rgba(255, 176, 32, 0.45);
    border-bottom-color: rgba(255, 176, 32, 0.45);
}

.ht-version-badge--error {
    color: var(--warning);
    border-left-color: rgba(255, 176, 32, 0.45);
    border-right-color: rgba(255, 176, 32, 0.45);
    border-top-color: rgba(255, 176, 32, 0.45);
    border-bottom-color: rgba(255, 176, 32, 0.45);
}

.ht-tab {
    min-height: 30px;
    min-width: 46px;
    max-width: 100%;
    background-color: var(--bg-surface);
    color: var(--text-secondary);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    flex-shrink: 1;
    overflow: hidden;
    white-space: nowrap;
}

.ht-tab > .unity-button__text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ht-tab:hover {
    background-color: rgba(255, 255, 255, 0.060);
    color: var(--text-primary);
}

.ht-tab:active {
    background-color: rgba(255, 255, 255, 0.040);
}

.ht-tab--active {
    background-color: var(--accent-primary);
    color: var(--text-primary);
    border-left-color: var(--accent-hover);
    border-right-color: var(--accent-hover);
    border-top-color: var(--accent-hover);
    border-bottom-color: var(--accent-hover);
}

.ht-btn-primary,
.ht-btn-secondary,
.ht-btn-ghost {
    min-height: 20px;
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    color: var(--text-primary);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    padding-left: 14px;
    padding-right: 14px;
    overflow: hidden;
    white-space: nowrap;
}

.ht-width-standard .ht-footer-button,
.ht-width-narrow .ht-footer-button {
    min-height: 32px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 11px;
}

.ht-btn-primary {
    background-color: var(--accent-primary);
    border-left-color: var(--accent-hover);
    border-right-color: var(--accent-hover);
    border-top-color: var(--accent-hover);
    border-bottom-color: var(--accent-hover);
}

.ht-btn-primary:hover {
    background-color: var(--accent-hover);
}

.ht-btn-primary:active {
    background-color: var(--accent-active);
}

.ht-btn-secondary {
    background-color: rgba(255, 255, 255, 0.045);
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
}

.ht-btn-secondary:hover,
.ht-btn-ghost:hover {
    background-color: rgba(255, 255, 255, 0.075);
}

.ht-btn-secondary:active,
.ht-btn-ghost:active {
    background-color: rgba(255, 255, 255, 0.050);
}

.ht-btn-ghost {
    background-color: transparent;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
}

.ht-btn-primary:disabled,
.ht-btn-secondary:disabled,
.ht-btn-ghost:disabled {
    color: var(--text-disabled);
    opacity: 0.55;
}

.ht-main-action-button {
    min-height: 20px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 11px;
}

.ht-field {
    color: var(--text-primary);
    align-self: stretch;
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
    overflow: hidden;
}

.ht-field > .unity-base-field__label {
    min-width: 0;
    width: 130px;
    max-width: 130px;
    flex-shrink: 1;
    color: var(--text-secondary);
    font-size: 12px;
    overflow: hidden;
}

.ht-scene-light-selector-field > .unity-base-field__label {
    display: none;
    min-width: 0;
    width: 0;
    margin-right: 0;
}

.ht-placement-wide-field .unity-base-field__label {
    min-width: 104px;
}

.ht-placement-compact-field .unity-base-field__label {
    min-width: 88px;
}

.ht-field > .unity-base-field__input {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ht-field > .unity-base-field__input .unity-object-field-display {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.ht-field > .unity-base-field__input .unity-object-field-display__text {
    min-width: 0;
}

.ht-field > .unity-base-field__input .unity-object-field__selector {
    min-width: 20px;
    width: 20px;
    max-width: 20px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 4px;
}

.ht-field:disabled {
    opacity: 0.85;
}

.ht-field:disabled > .unity-base-field__label,
.ht-field:disabled > .unity-base-field__input,
.ht-field:disabled .unity-object-field-display__text {
    color: var(--text-secondary);
}

.ht-toggle {
    color: var(--text-primary);
    align-self: flex-start;
    width: auto;
    max-width: 100%;
    min-width: 0;
    flex-shrink: 1;
    background-color: transparent;
    overflow: hidden;
}

.ht-toggle > .unity-base-field__label {
    color: var(--text-primary);
    font-size: 12px;
}

.ht-toggle > .unity-base-field__input,
.ht-toggle > .unity-toggle {
    width: auto;
    min-width: 0;
    max-width: 100%;
}

.ht-helpbox-info,
.ht-helpbox-warning,
.ht-helpbox-error {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.ht-helpbox-info {
    background-color: rgba(124, 77, 255, 0.10);
    border-left-color: rgba(124, 77, 255, 0.35);
    border-right-color: rgba(124, 77, 255, 0.35);
    border-top-color: rgba(124, 77, 255, 0.35);
    border-bottom-color: rgba(124, 77, 255, 0.35);
}

.ht-helpbox-warning {
    background-color: rgba(255, 176, 32, 0.10);
    border-left-color: rgba(255, 176, 32, 0.35);
    border-right-color: rgba(255, 176, 32, 0.35);
    border-top-color: rgba(255, 176, 32, 0.35);
    border-bottom-color: rgba(255, 176, 32, 0.35);
}

.ht-helpbox-error {
    background-color: rgba(255, 92, 92, 0.10);
    border-left-color: rgba(255, 92, 92, 0.35);
    border-right-color: rgba(255, 92, 92, 0.35);
    border-top-color: rgba(255, 92, 92, 0.35);
    border-bottom-color: rgba(255, 92, 92, 0.35);
}

.ht-status-pill {
    align-self: flex-start;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-left-radius: 999px;
    border-top-right-radius: 999px;
    border-bottom-left-radius: 999px;
    border-bottom-right-radius: 999px;
    font-size: 11px;
    -unity-font-style: bold;
}

.ht-status-pill--positive {
    background-color: rgba(76, 175, 109, 0.12);
    color: var(--success);
}

.ht-status-pill--neutral {
    background-color: rgba(255, 255, 255, 0.080);
    color: var(--text-secondary);
}

.ht-footer-title {
    margin-bottom: 2px;
    font-size: 12px;
    color: var(--text-primary);
    -unity-font-style: bold;
}

.ht-footer-subtitle {
    font-size: 11px;
    color: var(--text-secondary);
    white-space: normal;
}

.ht-stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-left: -8px;
    margin-top: -8px;
}

.ht-stat-item {
    min-width: 88px;
    flex-grow: 1;
    background-color: var(--bg-surface);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-left: 8px;
    margin-top: 8px;
}

.ht-listview {
    background-color: var(--bg-surface);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
    border-right-color: var(--border);
    border-top-color: var(--border);
    border-bottom-color: var(--border);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.ht-list-item {
    color: var(--text-primary);
    font-size: 12px;
    white-space: normal;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.ht-foldout {
    background-color: rgba(14, 15, 20, 0.35);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.ht-divider {
    height: 1px;
    background-color: rgba(56, 59, 74, 0.9);
    margin-top: 8px;
    margin-bottom: 8px;
}

.ht-assets-subtitle {
    color: var(--text-secondary);
    font-size: 11px;
    white-space: normal;
}

.ht-assets-summary {
    color: var(--text-secondary);
    font-size: 11px;
    white-space: normal;
}

.ht-assets-scroll {
    background-color: rgba(255, 255, 255, 0.028);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: var(--border);
